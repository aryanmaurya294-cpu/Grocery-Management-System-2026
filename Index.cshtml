
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row py-2">
        <div class="col-sm-10 mx-auto">
            <div class="fs-5"> Welcome back , <b class="text-color1">Aryan Maurya</b> <br />
   
            
            </div>
            <span style="font-size:13px;"> Here's what's happening with the account today.</span>
            <div class="row py-2">
                @*summary card start*@
                <div class="col-sm-3 p-3">
                    <div class="row shadow-lg p-2 rounded-3">
                        <div class="col-3">
                            <i class="fa-solid fa-shopping-bag icon1"></i>
                        </div>
                        <div class="col-9">

                            <span style="font-size:14px;">Total Orders</span> <br />
                            <b>@ViewBag.dt.Rows[0][0]</b> <br />
                            
                            <a class="text-decoration-none badge text-light bg-dark" href="/admin/manageorders">View all Orders  <i class="fa-solid fa-arrow-right bg-dark"></i></a>
                        </div>

                    </div>
                </div>
                <div class="col-sm-3 p-3">
                    <div class="row shadow-lg p-2 rounded-3">
                        <div class="col-3">
                            <i class="fa-solid fa-box icon1"></i>
                        </div>
                        <div class="col-9">
                            <span style="font-size:14px;">Delivered Orders</span> <br />
                            <b>@ViewBag.dn.Rows[0][0]</b> <br />
                            <a class="text-decoration-none badge text-light bg-dark" href="/admin/delevireyorder">View all Delivered  <i class="fa-solid fa-arrow-right bg-dark"></i></a>
                        </div>

                    </div>
                </div>
                <div class="col-sm-3 p-3">
                    <div class="row shadow-lg p-2 rounded-3">
                        <div class="col-3">
                            <i class="fa-solid fa-tags icon1"></i>
                        </div>
                        <div class="col-9">
                            <span style="font-size:14px;">Total Categories</span> <br />
                            <b>@ViewBag.tc.Rows[0][0]</b> <br />
                            <a class="text-decoration-none badge text-light bg-dark" href="/admin/addcategory">View all Categories  <i class="fa-solid fa-arrow-right bg-dark"></i></a>
                        </div>

                    </div>
                </div>
                <div class="col-sm-3 p-3">
                    <div class="row shadow-lg p-2 rounded-3">
                        <div class="col-3">
                            <i class="fa-solid fa-shopping-cart icon1"></i>
                        </div>
                        <div class="col-9">
                            <span style="font-size:14px;">Total Products</span> <br />
                            <b>@ViewBag.p.Rows[0][0]</b> <br />
                            <a class="text-decoration-none badge text-light bg-dark" href="/admin/addproduct">View all Products  <i class="fa-solid fa-arrow-right bg-dark"></i></a>
                        </div>

                    </div>
                </div>
                @*summary card end*@



            </div>
            <div class="row g-4 py-3">

                <!-- Recent Orders -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-lg rounded-4 h-100">
                        <div class="card-header bg-dark text-white rounded-top-4 py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-shopping-bag me-2"></i>Recent Orders
                            </h5>
                        </div>

                        <div class="card-body p-0">

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">

                                    <thead class="table-light">
                                        <tr>
                                            <th>#Order</th>
                                            <th>Date</th>
                                            <th>Email</th>
                                            <th>Price</th>
                                            <th>Qty</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var row in ViewBag.ro.Rows)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="badge bg-primary px-3 py-2">
                                                        @row["orderid"]
                                                    </span>
                                                </td>

                                                <td>
                                                    @Convert.ToDateTime(row["added_on"]).ToString("dd MMM yyyy")
                                                </td>

                                                <td>@row["email"]</td>

                                                <td class="fw-bold text-success">
                                                    ₹@row["totalprice"]
                                                </td>

                                                <td>
                                                    <span class="badge bg-warning text-dark">
                                                        @row["qty"]
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>

                                </table>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Recent Customers -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-lg rounded-4 h-100">

                        <div class="card-header bg-dark text-white rounded-top-4 py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-users me-2"></i>Recent Customers
                            </h5>
                        </div>

                        <div class="card-body p-0">

                            <div class="table-responsive">

                                <table class="table table-hover align-middle mb-0">

                                    <thead class="table-light">
                                        <tr>
                                            <th>Email</th>
                                            <th>Date</th>
                                            <th>Name</th>
                                            <th>Gender</th>
                                            <th>Mobile</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var item in ViewBag.rc.Rows)
                                        {
                                            <tr>

                                                <td>@item["email"]</td>

                                                <td>
                                                    @Convert.ToDateTime(item["added_on"]).ToString("dd MMM yyyy")
                                                </td>

                                                <td class="fw-semibold">
                                                    @item["name"]
                                                </td>

                                                <td>
                                                    @if (item["gender"].ToString() == "Male")
                                                    {
                                                        <span class="badge bg-primary">Male</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Female</span>
                                                    }
                                                </td>

                                                <td>@item["mobile"]</td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

