
@{
    ViewBag.Title = "allorders";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-10 mx-auto p-4">
            <div class="fs-3">   All <b class="text-color1 ">Orders</b></div>
            view all your completed orders at one place
            <hr class="w-50" />
            <button type="button" class="btn shadow bg-dark text-light" disabled>All Orders (10)</button> &nbsp; &nbsp;
            <button type="button" class="btn btn-outline-dark" disabled>Processing (5)</button>&nbsp; &nbsp;
            <button type="button" class="btn btn-outline-dark" disabled>Processing (5)</button>&nbsp; &nbsp;
            <button type="button" class="btn btn-outline-dark" disabled>Out For Delivery (3)</button>&nbsp; &nbsp;
            <button type="button" class="btn btn-outline-dark" disabled>Delivered (3)</button>&nbsp; &nbsp;
            <button type="button" class="btn btn-outline-dark" disabled>Cancelled (2)</button>

            @*order box start*@
            @foreach (var row in ViewBag.dt.Rows)
            {
                <div class="row shadow-sm p-3 mb-2 bg-body-tertiary rounded mt-2 align-items-center">
                    <div class="col-sm-2">
                        <span class="text-secondary small">Order Id</span> <br />
                        <span class="text-dark fw-medium ">@row["orderid"]</span>
                    </div>
                    <div class="col-sm-2">
                        <span class="text-secondary small">Order Date</span> <br />
                        <span class="text-dark fw-medium ">@row["order_on"]</span>
                    </div>
                    <div class="col-sm-2">
                        <span class="text-secondary small">Total Amount</span> <br />
                        <span class="text-dark fw-medium "><i class="fa fa-rupee-sign"></i>@row["total"]</span>
                    </div>
                    <div class="col-sm-2">
                        <span class="text-secondary small">Payment Method</span> <br />
                        <span class="text-dark fw-medium ">@row["payment_method"]</span>
                    </div>
                    <div class="col-sm-2">
                        <span class="text-secondary small">Current Status</span> <br />
                        <span class="text-success fw-medium ">@row["cur_status"]</span>
                    </div>


                    <div class="col-sm-2">
                        <a href="/general/orderproducts?oid=@row["orderid"]">
                            <button class="btn btn-outline-primary"><i class="fa fa-caret-down"></i>View Products</button>
                        </a>
                    </div>
                    <div class="col-sm-2">
                        <span class="text-secondary small">Current Status</span> <br />
                        <span class="text-success fw-medium ">@row["cur_status"]</span>
                    </div>



                    <div class="col-sm-12 alert alert-success mt-2 mb-2 text-items-ceter ">
                        <span class="text-dark fw-bold">Order Status</span>
                        <div class="row  align-items-center">

                            <div class="col-sm-2">
                                <span class="text-secondary small">Order placed On</span> <br />
                                <span class="text-success fw-medium ">@row["order_on"]</span>
                            </div>

                            <div class="col-sm-2">
                                <span class="text-secondary small">Order Accepted On</span> <br />
                                <span class="text-dark fw-medium ">@row["accept_on"]</span>
                            </div>

                            <div class="col-sm-2">
                                <span class="text-secondary small">Out For Delivery</span> <br />
                                <span class="text-success fw-medium ">@row["out_for_delivery"]</span>
                            </div>

                            <div class="col-sm-2">
                                <span class="text-secondary small">Delevired On</span> <br />
                                <span class="text-success fw-medium ">
                                    @row["deliver_on"]
                                </span>
                            </div>
                            <div class="col-sm-2">
                                <span class="text-secondary small">Expected Delivery time</span> <br />
                                <span class="text-success fw-medium ">
                                    @row["expected_delivery"]
                                </span>
                            </div>
                        </div>




                    </div>

                </div>
                @*order box end*@

            }

            @*order box end*@





        </div>
    </div>
</div>



