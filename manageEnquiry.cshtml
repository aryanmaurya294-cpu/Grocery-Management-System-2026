
@{
    ViewBag.Title = "manageEnquiry";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}



<div class="table-responsive shadow-lg p-3 bg-white rounded">
    <table class="table table-bordered table-hover table-striped align-middle text-center">

        <div class="container-fluid">
            <div class="row py-3">
                <div class="col-sm-10 mx-auto">
                    <div class="fs-2 text-center fw-bold mb-4">
                        <i class="fa-solid fa-envelope-open-text text-primary"></i>
                        Manage <span class="text-success">Enquiry</span>
                    </div>
                    <table class="table " border="3">
                        <thead class="table-success">
                            <tr>

                                <th>Name</th>
                                <th>MOb No.</th>
                                <th>Email.</th>
                                <th>enq_type</th>
                                <th>subject</th>
                                <th>message</th>

                                <th>status</th>


                                <th>remark.</th>
                                <th>added_on</th>
                                <th>Delete_Enqriry</th>

                            </tr>
                        </thead>


                        @foreach (var row in ViewBag.dt.Rows)
                        {



                            <tr>

                                <td>@row["name"]</td>
                                <td>@row["mobile"]</td>
                                <td>@row["email"]</td>
                                <td>@row["enq_type"]</td>
                                <td>@row["subject"]</td>
                                <td>@row["message"]</td>
                                <td>
                                    @if (row["status"].ToString() == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Resolved</span>
                                    }
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(row["remark"].ToString()))
                                    {
                                        <span class="badge bg-secondary">No Remark</span>
                                    }
                                    else
                                    {
                                        @row["remark"]
                                    }
                                </td>

                                <td>@row["added_on"]</td>

                                <td>
                                    <a href="/Admin/DeleteEnquiry?id=@row["id"]"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Delete this enquiry?')">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </a>
                                </td>


                            </tr>

                        }

                    </table>
                   
                </div>
            </div>
        </div>
        </table>
    </div>

